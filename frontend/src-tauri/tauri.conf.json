{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Holograma UNEV",
  "version": "0.1.0",
  "identifier": "com.unev.holograma",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../../static"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Holograma UNEV",
        "width": 1280,
        "height": 800,
        "minWidth": 420,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
