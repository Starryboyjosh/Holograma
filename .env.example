# ===================== LLM: proveedor y modelo =====================
# Contrato único (ver provider_config.py). Normalmente esto se edita desde la
# pantalla de Ajustes; estas variables son el respaldo en .env para desarrollo.
#
# LLM_PROVIDER elige el proveedor y es AUTORITATIVO: si lo fijas, se respeta tu
# elección (incluido 'ollama') y NO se cambia en silencio a otro proveedor por
# una API key vieja. Valores: openrouter | openai | claude_native | nvidia |
# groq | custom_openai | ollama | local_only. Vacío = autodetección por la primera key.
LLM_PROVIDER=openrouter

# Modelo para el proveedor en la nube activo. La interfaz escribe aquí; aplica a
# openrouter/openai/nvidia/claude_native/groq salvo que fijes el override específico
# de abajo. Ollama usa OLLAMA_MODEL aparte (nunca hereda este valor).
LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Límite de longitud de la respuesta, único para TODOS los backends (entero > 0).
# Vacío o inválido = 450. Ver docs/CONFIG.md ("Límite de tokens").
# LLM_MAX_TOKENS=450

# Volcar el CoT/razonamiento del modelo en la terminal (diagnóstico).
# Activo por defecto; desactivar con 0 si ensucia demasiado el log.
# LLM_LOG_COT=1

# Timeout HTTP del cliente LLM en la nube (segundos). Por defecto 90.
# Si se cuelga en "intento … backend=openrouter", bájalo o revisa la API key.
# LLM_REQUEST_TIMEOUT=90

# API keys (déjalas vacías si no usas ese proveedor).
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
NVIDIA_API_KEY=
# Groq: LLM (proveedor "groq") y STT whisper-large-v3-turbo comparten esta key.
GROQ_API_KEY=

# Overrides opcionales por proveedor (tienen prioridad sobre LLM_MODEL). Útiles
# para usuarios avanzados en .env; la interfaz no los toca.
# OPENAI_MODEL=gpt-4o-mini
# NVIDIA_MODEL=moonshotai/kimi-k2.6
# ANTHROPIC_MODEL=claude-3-5-sonnet-latest
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_BASE_URL=https://api.openai.com/v1
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# Endpoint propio compatible con OpenAI (vLLM, LM Studio, gateway, LiteLLM…).
# Requiere LLM_PROVIDER=custom_openai y una URL base.
# OPENAI_COMPAT_BASE_URL=http://127.0.0.1:8080/v1
# OPENAI_COMPAT_MODEL=
# OPENAI_COMPAT_API_KEY=

# Ollama local (sin internet). El modelo se elige en Ajustes.
OLLAMA_MODEL=gemma3:1b
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Cache del sondeo "¿Ollama está listo?" en segundos (por defecto 10). Evita
# golpear el servicio en cada turno; el sondeo corre fuera del event loop.
# OLLAMA_READY_TTL_SECONDS=10

# LLM_BACKEND está OBSOLETO: era un override manual ('openai', 'ollama', …).
# Se sigue respetando por compatibilidad, pero usa LLM_PROVIDER en su lugar.
# LLM_BACKEND=auto

# Seguridad: orígenes permitidos para CORS. Vacío = "*" (comportamiento histórico,
# válido porque el backend solo escucha en localhost). Para endurecerlo en
# producción, tras validar el origen real del WebView de Tauri, usa una lista
# separada por comas, p. ej.:
# CORS_ALLOW_ORIGINS=tauri://localhost,http://tauri.localhost,https://tauri.localhost
CORS_ALLOW_ORIGINS=

# Token de capacidad opcional para endpoints privilegiados (ajustes, contenido,
# cámara, entrenamiento). Vacío = desactivado (comportamiento histórico). Al
# activarlo, esas escrituras requieren el header X-API-Token y la shell de Tauri
# debe entregar el token al frontend (ver docs/HANDOFF.md, D.2).
# HOLOGRAM_API_TOKEN=

HOLOGRAM_INPUT=keyboard
HOLOGRAM_CAMERA=0
HOLOGRAM_CAMERA_INDEX=0
HOLOGRAM_FACE_ANALYSIS=0
HOLOGRAM_CAMERA_BACKEND=

# Ventilador holográfico físico (control TCP, puerto 50200).
# Deja HOLOGRAM_TCP_IP vacío para correr la IA sin dispositivo (modo software).
# 10.10.10.1 = WiFi directo del fan; o la IP fija que reserves en el router SpinDisplay.
HOLOGRAM_TCP_IP=
HOLOGRAM_TCP_PORT=50200
HOLOGRAM_TCP_VERBOSE=0

# Mapeo estado de la IA → índice de clip en la playlist del dispositivo.
# El índice es el ORDEN en que cargaste los MP4 en la app HoloMissYou (0 = primero),
# no el nombre del archivo. Sólo redefine esto si NO cargaste los clips en el orden
# idle, escuchando, hablando, pensando. Vacío = usa el orden por defecto 0,1,2,3.
HOLOGRAM_CLIP_IDLE=0
HOLOGRAM_CLIP_LISTENING=1
HOLOGRAM_CLIP_SPEAKING=2
HOLOGRAM_CLIP_THINKING=3

# Un solo modelo open-vocab: personas + clases de Entrenar (set_classes).
# Primera ejecución puede descargar pesos si no están en models/.
YOLO_MODEL=yoloe-26n-seg.pt
# YOLOE open-vocab: conf persona ~0.28; custom más bajo (predict usa el mínimo).
YOLO_CONFIDENCE=0.28
YOLO_CUSTOM_CONFIDENCE=0.12
# Uniforme open-vocab: más estricto + exige logo amarillo-sobre-azul (anti FP).
YOLO_UNIFORM_CONFIDENCE=0.45
# YOLO_UNIFORM_YELLOW_MIN=0.015
# YOLO_UNIFORM_BLUE_MIN=0.12
YOLO_INTERVAL_SECONDS=0.6
YOLO_IMGSZ=416
YOLO_MAX_SIDE=960
# YOLO_IOU=0.5
# YOLO_MAX_DET=50
# YOLO_DEVICE=cpu
# YOLO_HALF=0
# HOLOGRAM_YOLO_DEBUG=1
# Resolución pedida al driver (0 = default de la cámara). 640x480 ahorra CPU.
HOLOGRAM_CAMERA_WIDTH=640
HOLOGRAM_CAMERA_HEIGHT=480
# Anti-rebote de presencia: segundos sostenidos antes de saludar (entrada) y
# antes de declarar que la persona se fue (salida). Evitan saludos/cortes por un
# parpadeo del detector. PRESENCE_ENTER_SECONDS=0 saluda de inmediato.
PRESENCE_ENTER_SECONDS=0.8
PRESENCE_ABSENCE_SECONDS=5.0

WHISPER_MODEL=base
# Idioma del STT. El kiosco fuerza español: vacío/auto → es. No uses auto-detect.
WHISPER_LANGUAGE=es
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_SAMPLE_RATE=16000
# 2 = más rápido; 3 default (mejor precisión); 5 = más lento.
WHISPER_BEAM_SIZE=3
# Fin de turno (segundos de silencio para cortar la grabación).
WHISPER_SILENCE_DURATION=1.2
# Captura de mayor calidad (local + Groq usan el mismo preprocesado):
# WHISPER_PREROLL_SECONDS=0.45
# WHISPER_PAD_SECONDS=0.18
# WHISPER_NORMALIZE_PEAK=0.85
# WHISPER_MAX_BOOST=10
# WHISPER_HIGHPASS_HZ=80
# WHISPER_SPEECH_ONSET_BLOCKS=2
# WHISPER_INPUT_DEVICE=   # índice o nombre sounddevice; vacío = default
# WHISPER_VAD_MIN_SILENCE_MS=400
# WHISPER_VAD_SPEECH_PAD_MS=200
# Hotwords (data/unev + honduras + kiosco) y prompt de contexto van siempre activos
# en faster-whisper; en Groq STT van embebidos en el prompt (sin param hotwords).
# Groq impone prompt ≤896 caracteres: el default (880) deja margen por tildes UTF-8.
# WHISPER_MAX_HOTWORDS=400
# WHISPER_PROMPT_MAX_CHARS=880

TTS_BACKEND=auto
# 1 = hablar por cláusulas mientras streamea el LLM (menor latencia a 1er audio).
HOLOGRAM_TTS_STREAM=1
PIPER_MODEL_PATH=models/es_MX-claude-high.onnx
PIPER_COMMAND=
PIPER_TIMEOUT_SECONDS=120
# Piper se carga UNA vez in-process (menos hueco LLM→voz). Solo depuración:
# PIPER_FORCE_CLI=1
